# Kopirajte u .env (ili unesite u podešavanja hostinga) i upišite svoje vrednosti.

# Obavezno pri prvom pokretanju: lozinka za korisnika "admin" (bar 10 znakova).
# Posle prvog pokretanja lozinke se menjaju u panelu, ova vrednost se više ne koristi.
ADMIN_PASSWORD=promenite-ovu-lozinku

# Server
PORT=3000
DATA_DIR=./data
TRUST_PROXY=1
# Javna adresa sajta za linkove u e-porukama (ako se razlikuje od one u panelu)
# PUBLIC_URL=https://www.vas-servis.rs

# Slanje e-pošte (npr. Brevo: smtp-relay.brevo.com, port 587)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=starttls
# SMTP_USER=korisnik-sa-brevo-naloga
# SMTP_PASS=smtp-kljuc-sa-brevo-naloga
# MAIL_FROM=Reset servis <servis@vas-servis.rs>
# MAIL_REPLY_TO=servis@vas-servis.rs

# Opciono
# BACKUP_KEEP=14
# NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/...
